# Copy to .env and adjust. Never commit .env.

# --- Retrieval ---
# "hashing" = offline, zero-download (good for CI/demos)
# "fastembed" = BAAI/bge-small-en-v1.5 neural embeddings (recommended)
KC_EMBEDDER=fastembed
# "lexical" = offline heuristic, "cross-encoder" = ms-marco MiniLM cross-encoder via fastembed, "none"
KC_RERANKER=cross-encoder
KC_DATA_DIR=data/corpus
KC_INDEX_DIR=.index
# Optional: use a Qdrant server instead of in-process vectors (docker run -p 6333:6333 qdrant/qdrant)
# KC_QDRANT_URL=http://localhost:6333
KC_TOP_K=5
# Below this rerank confidence the copilot abstains instead of guessing (and skips the LLM call)
KC_MIN_CONFIDENCE=0.40

# --- Generation ---
# "offline" = extractive answers, no API key needed
# "openai"  = any OpenAI-compatible endpoint: Ollama, Groq, OpenAI, Gemini, OpenRouter, vLLM ...
KC_LLM_PROVIDER=offline

# Ollama (free, fully local, private):
# KC_LLM_PROVIDER=openai
# KC_LLM_BASE_URL=http://localhost:11434/v1
# KC_LLM_MODEL=llama3.2:3b
# KC_LLM_API_KEY=ollama

# Groq (free tier):
# KC_LLM_BASE_URL=https://api.groq.com/openai/v1
# KC_LLM_MODEL=llama-3.1-8b-instant
# KC_LLM_API_KEY=your-key-here

# Gemini (free tier, OpenAI-compatible endpoint):
# KC_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# KC_LLM_MODEL=gemini-2.0-flash
# KC_LLM_API_KEY=your-key-here
